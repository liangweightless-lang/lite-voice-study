# =================================================================
# Lite Voice Study - Git 忽略规则文件 (安全第一，防止密钥与依赖泄露)
# =================================================================

# 1. 密钥与环境配置 (绝对不能上传)
.env
.env.*
*.env
!.env.example

# 2. Python 虚拟环境与缓存
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.log

# 3. 前端 Node 依赖与构建打包产物
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. 操作系统与编辑器临时文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 5. AI 智能体产生的本地缓存
.claude/
.antigravity/
.gemini/
